# ============================================================
# NexusMCP — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── LLM Provider ─────────────────────────────────────────────
# Options: gemini | ollama
LLM_PROVIDER=gemini

# Google Gemini (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Ollama (required when LLM_PROVIDER=ollama)
# Can point to local laptop or in-cluster service
OLLAMA_BASE_URL=http://localhost:11434
# Use a model that supports tool calling: llama3.1, qwen3, gemma4
OLLAMA_MODEL=llama3.1

# ── Platform Database (PostgreSQL) ───────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexusmcp
POSTGRES_USER=nexusmcp
POSTGRES_PASSWORD=change-me-strong-password

# ── WooCommerce Store Database (MariaDB) ─────────────────────
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_DATABASE=wordpress
MARIADB_USER=wordpress
MARIADB_PASSWORD=change-me-strong-password
MARIADB_ROOT_PASSWORD=change-me-root-password

# ── WordPress / WooCommerce ───────────────────────────────────
WORDPRESS_URL=http://store.nexusmcp.local
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=change-me-wp-password
WORDPRESS_ADMIN_EMAIL=admin@example.com

# WooCommerce REST API credentials (generated in WP Admin → WooCommerce → Settings → Advanced → REST API)
WC_CONSUMER_KEY=ck_your_consumer_key_here
WC_CONSUMER_SECRET=cs_your_consumer_secret_here

# ── Gateway ───────────────────────────────────────────────────
# Secret used to sign internal tokens (min 32 chars)
GATEWAY_SECRET_KEY=change-me-to-a-random-32-char-string

# ── Upstream MCP Server URLs (cluster-internal) ──────────────
# These point to Kubernetes Service DNS names inside the cluster
WOOCOMMERCE_MCP_URL=http://woocommerce-mcp-svc:8001/mcp
TIME_MCP_URL=http://time-mcp-svc:8002/mcp
FETCH_MCP_URL=http://fetch-mcp-svc:8003/mcp

# ── SSRF Guard ────────────────────────────────────────────────
# Comma-separated allowlist of internal hostnames the gateway MAY connect to
# (Used to allow registered internal MCP servers despite RFC1918 block)
SSRF_INTERNAL_ALLOWLIST=woocommerce-mcp-svc,time-mcp-svc,fetch-mcp-svc

# ── Fetch MCP ─────────────────────────────────────────────────
# Optional domain allowlist for the fetch tool (empty = block all external by default)
FETCH_ALLOWED_DOMAINS=

# ── Dashboard ─────────────────────────────────────────────────
# URL the frontend uses to reach the backend API
VITE_API_BASE_URL=http://api.nexusmcp.local

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
